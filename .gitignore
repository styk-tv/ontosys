# Rust/Cargo
target/
# Cargo.lock IS committed: this crate ships a binary, so the lockfile pins the
# exact release build and doubles as the CI cache key. Only library crates omit it.
*.rlib
*.rmeta
*.so
*.dylib
*.dll

# IDE
.vscode/*
!.vscode/settings.json
.idea/
*.swp
*.swo
*~
.DS_Store

# Build artifacts
dist/
build/
*.o
*.a

# Testing
*.profraw
*.profdata
/coverage

# Environment
.env
.env.local

# Fleet spec discipline (pgCK / sporaxis convention): SPEC* documents are
# private working papers and may carry local paths — never tracked.
SPEC*
# The docs layer embeds every .md verbatim (SPEC* included) into
# .ontosys/data/docs.json, so the graph output stays untracked too.
.ontosys/
